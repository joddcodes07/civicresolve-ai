dist/
build/

# electron-builder build resource folder (Milestone 17)
# Allow source/config files that must be committed; ignore generated binary icons
!build/
!build/entitlements.mac.plist
!build/generate-icons.cjs
# Keep generated icons out of the repo (generated by CI / local script)
build/icon.icns
build/icon.ico
build/icons/
build/icon.iconset/

