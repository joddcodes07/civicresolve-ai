# ---- CivicResolve-AI · server environment (copy to .env) ----
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/civicresolve?schema=public"

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ---- AI engine (optional upgrade; empty = fully local rules classifier) ----
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_BASE_URL=""
LLM_TIMEOUT_MS=8000

# ---- Notifications ----
MAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CivicResolve <no-reply@civicresolve.local>"

# ---- SLA watchdog ----
SLA_CRON_ENABLED=true
SLA_CRON_SCHEDULE="*/15 * * * *"
