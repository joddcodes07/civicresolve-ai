# ---- CivicResolve-AI · server environment (copy to .env) ----
# Prisma uses PostgreSQL; Supabase is not required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/civicresolve"
# CLI/migrations connection (use the same URL for regular PostgreSQL).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/civicresolve"

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

JWT_SECRET=""
TRUST_PROXY_HOPS=0
PASSWORD_RESET_URL="http://localhost:5173/reset-password"
WORK_EMAIL_DOMAINS=""
DEMO_ACCOUNTS_ENABLED=false
JWT_EXPIRES_IN="7d"

# ---- AI engine (optional upgrade; empty = fully local rules classifier) ----
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL=""
LLM_BASE_URL=""
LLM_TIMEOUT_MS=8000

# ---- Notifications ----
MAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CivicResolve <no-reply@civicresolve.local>"

# ---- SLA watchdog ----
SLA_CRON_ENABLED=true
SLA_CRON_SCHEDULE="*/15 * * * *"

# Google OAuth (Web application). Register CLIENT_ORIGIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
