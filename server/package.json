{
  "name": "@civicresolve/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-force-exit \"src/tests/**/*.test.js\"",
    "data:import": "node scripts/import-pune.js",
    "data:fetch-places": "node scripts/fetch-pune-places.js",
    "user:provision": "node scripts/provision-work-user.js",
    "ai:evaluate": "node scripts/evaluate-ai.js",
    "test:integration": "node --test --test-force-exit src/tests/integration.test.js",
    "data:import-complaints": "node scripts/import-complaints.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.3.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
